# Public canonical URL used by metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.westadelaidelegal.com.au

# Optional server-side contact form delivery endpoint.
# When omitted, the form remains fully usable for validation and shows a clear
# integration-unavailable state instead of losing the enquiry.
CONTACT_FORM_ENDPOINT=

# Optional bearer token sent only from the server route to the form provider.
CONTACT_FORM_TOKEN=
