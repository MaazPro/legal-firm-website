# Public canonical URL used by metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.westadelaidelegal.com.au

# Server-only SMTP credentials. Never prefix these with NEXT_PUBLIC_.
# Hostinger Email defaults: smtp.hostinger.com, port 465, SSL enabled.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=akrishnan@westadelaidelegal.com.au
SMTP_PASSWORD=replace-with-the-mailbox-password
SMTP_FROM_EMAIL=akrishnan@westadelaidelegal.com.au

# Address that receives website enquiries.
CONTACT_TO_EMAIL=akrishnan@westadelaidelegal.com.au
